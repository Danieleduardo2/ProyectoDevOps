# ============================================
# Configuración de Base de Datos
# ============================================
SPRING_PORT=8080
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/eventos_db
DB_USER=postgres
DB_PASSWORD=tu_password_db

# ============================================
# Configuración JWT
# ============================================
JWT_SECRET=cambia_este_secreto_debe_ser_minimo_32_caracteres_seguro
JWT_EXPIRATION=86400000

# ============================================
# Configuración SMTP (Correo electrónico)
# ============================================
# Para DESARROLLO con Mailtrap (gratis):
#   SMTP_HOST=sandbox.smtp.mailtrap.io
#   SMTP_PORT=2525
#   SMTP_USERNAME=tu_usuario_mailtrap
#   SMTP_PASSWORD=tu_password_mailtrap
#
# Para PRODUCCIÓN con Gmail:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USERNAME=tu_email@gmail.com
#   SMTP_PASSWORD=tu_app_password (genera en Google Account)
#
# Para PRODUCCIÓN con Brevo (SendinBlue):
#   SMTP_HOST=smtp-relay.brevo.com
#   SMTP_PORT=587
#   SMTP_USERNAME=tu_email@example.com
#   SMTP_PASSWORD=tu_brevo_api_key
#
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USERNAME=tu_usuario_mailtrap
SMTP_PASSWORD=tu_password_mailtrap
SMTP_AUTH=true
SMTP_STARTTLS_ENABLE=true
SMTP_STARTTLS_REQUIRED=true
SMTP_FROM=no-reply@eventos.local

# ============================================
# Configuración QR
# ============================================
QR_API_URL=https://api.qrserver.com/v1/create-qr-code
QR_SIZE=300x300
